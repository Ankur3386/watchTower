{
  "name": "watchTower",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:dbCore-generate":" cd packages/db/dbcore && npx prisma generate && cd ../../..",
    "dev:db-timescale-generate":"cd packages/db/db-timescale && npx prisma generate && cd ../../..",
    "start:http":"cd apps/http_backend && node dist/index.js",
    "start:frontend":"cd apps/frontend && npm run dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
